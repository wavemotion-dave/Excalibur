    LISTBOX         TRACE_PROGRAM,255,12,119,191,WS_VSCROLL
    LISTBOX         TRACE_REGS1,5,13,119,190,LBS_NOINTEGRALHEIGHT | 
                    WS_VSCROLL
    LISTBOX         TRACE_REGS2,130,13,119,190,LBS_NOINTEGRALHEIGHT | 
                    WS_VSCROLL
END

DIALOG_INPUT DIALOG DISCARDABLE  145, 25, 186, 58
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION
CAPTION "Excalibur Debugger"
FONT 10, "MS Sans Serif"
BEGIN
    EDITTEXT        IDC_EDIT1,77,14,73,14,ES_AUTOHSCROLL
    DEFPUSHBUTTON   "OK",IDOK,35,37,50,14
    LTEXT           "Input New Value:",-1,15,17,58,10
    DEFPUSHBUTTON   "Cancel",IDCANCEL,101,37,50,14
END


/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

EXCALIBUR_MENU MENU DISCARDABLE 
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&Settings...\tCtrl+S",        IDM_SETTINGS
        MENUITEM "System &Usage Stats...    \tCtrl+U", IDM_USAGESTATS
        MENUITEM "&Define Custom Set...\tCtrl+D", IDM_DEFINECUSTOM
        MENUITEM "&Program Manager...\tCtrl+P", IDM_MACRO
        MENUITEM "E&xit\tCtrl+X",               IDM_EXIT
    END
    POPUP "&Edit"
    BEGIN
        MENUITEM "&Copy X \tCtrl+C",            IDM_COPYXTOCLIPBOARD
        MENUITEM "Copy &All Stack\tCtrl+A",     IDM_COPYALLTOCLIPBOARD
        MENUITEM "&Paste X\tCtrl+V",            IDM_COPYCLIPBOARDTOX
        MENUITEM SEPARATOR
        MENUITEM "&Always On Top",              IDM_ALWAYSONTOP
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&Excalibur Help",             IDM_EXCALIBURHELP
        MENUITEM "&About Excalibur",            IDM_ABOUTPROGRAM
    END
END


